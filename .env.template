# Copy this file to .env and adjust values as needed.
# .env is gitignored; .env.template is committed.

# Base URL for the data.tg.ch ODS v2.1 API
TG_API_BASE=https://data.tg.ch/api/explore/v2.1/catalog/datasets

# Year to fetch from data.tg.ch — leave empty for auto-detect (newest available)
# Example values: 2024, 2023, 2022
TG_DATA_YEAR=

# Douglas-Peucker simplification tolerance for Gemeinde geometries (in degrees, WGS84).
# 0.0001 ≈ 11m,  0.0002 ≈ 22m,  0.0005 ≈ 56m,  0.001 ≈ 111m.
# 0.0002 is a good balance between detail and embedded file size for Thurgau.
GEO_SIMPLIFY_TOLERANCE=0.0002
